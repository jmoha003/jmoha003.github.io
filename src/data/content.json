  "research": {
    "title": "Dual-Perspective Measurement for Agent-Based Models",
    "subtitle": "Testing the Adequacy of the Single-Perspective Measurement Convention",
    "status": "Dissertation proposal · August 2026",
    "committee": [
      {
        "name": "Dr. Andrew J. Collins",
        "role": "Director",
        "url": "https://www.odu.edu/directory/andy-collins"
      },
      {
        "name": "Dr. Ambrosio Valencia-Romero",
        "role": "Member",
        "url": "https://www.odu.edu/directory/ambrosio-valencia-romero"
      },
      {
        "name": "Dr. James F. Leathrum",
        "role": "Member",
        "url": "https://www.odu.edu/directory/jim-leathrum"
      }
    ],
    "premise": "Agent-based models are almost always measured from the population perspective alone. That convention assumes one perspective is enough to describe a final state. The assumption is untested.",
    "questions": [
      "Can disagreement between the independently measured agent perspective and population perspective be detected at the final state of a simulation?",
      "Which parameters most strongly influence the probability that the two perspectives disagree?"
    ],
    "method": "Axelrod (1997) cultural dissemination model as testbed. Full factorial design across a toroidal lattice and a scale-free network. No new model and no changed rules, so any disagreement belongs to the measurements rather than the model."
  },
