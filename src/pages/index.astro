---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import content from '../data/content.json';
import projects from '../data/projects.json';
import publications from '../data/publications.json';
import gallery from '../data/gallery.json';

const { profile, metrics, capabilities, experience, additional, teaching, education, patents, awards, fellowships, record, certifications, leadership, research, logoTiers, alma, almaLabel, press, reviewer, grants, talks, contributions } = content;
const imgs = import.meta.glob('../assets/images/**/*.{jpg,jpeg,png}', { eager: true });
const pic = (name) => imgs[`../assets/images/${name}`]?.default;
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const topics = [...new Set(publications.flatMap((p) => p.topics))].sort();
const title = 'Joshit Mohanty | Agent-Based Modeling & Simulation';
const description = 'Ph.D. candidate in Engineering Management & Systems Engineering at Old Dominion University. Agent-based models, digital twins, and applied AI for fleet operations, matching markets, healthcare and space systems.';
---
<Base title={title} description={description}>

<!-- ═══ HERO ═══ -->
<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <span class="status"><span class="dot"></span>{profile.affiliation.split(',')[1]?.trim() ?? 'Old Dominion University'}</span>
      <h1>Joshit<br /><em>Mohanty</em></h1>
      <p class="role">{profile.role}</p>
      <p class="tag"><b>{profile.tagline}</b> {profile.blurb}</p>
      <div class="domains">{profile.domains.map((d) => <span>{d}</span>)}</div>
      <div class="cta-row">
        <a class="btn btn-p" href="#lab">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 3 14 9-14 9V3Z"/></svg>
          Run a simulation
        </a>
        <a class="btn btn-g" href={profile.resume}>Résumé</a>
        <a class="btn btn-g" href={profile.scholar} rel="noopener">Scholar</a>
        <a class="btn btn-g" href={profile.orcid} rel="noopener">ORCID</a>
      </div>
    </div>
    <figure class="portrait">
      {pic('headshot.jpeg') && <Image src={pic('headshot.jpeg')} alt={`Portrait of ${profile.name}`} widths={[380, 620, 900]} sizes="(max-width:980px) 330px, 40vw" loading="eager" fetchpriority="high" />}
      <figcaption class="cap">{profile.location} · {profile.authorization}</figcaption>
    </figure>
  </div>
</section>

<div class="after-hero">

<!-- ═══ METRICS ═══ -->
<section class="tight">
  <div class="wrap">
    <div class="metrics stagger">
      {metrics.map((m) => (
        <div class="metric">
          <div class="n" data-count={m.value} data-prefix={m.prefix ?? ''} data-suffix={m.suffix ?? ''}>{m.prefix ?? ''}0{m.suffix ?? ''}</div>
          <div class="l">{m.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ AFFILIATIONS ═══ -->
<section class="tight">
  <div class="wrap">
    <p class="eyebrow rv" style="margin-bottom:1.2rem">{almaLabel}</p>
    <div class="alma stagger">
      {alma.map((a) => (
        <div class="alma-card" title={a.name}>
          <img src={a.logo} alt={a.name} loading="lazy" width="180" height="52" />
          <span class="alma-note">{a.note}</span>
        </div>
      ))}
    </div>
    {logoTiers.map((tier) => (
      <>
        <p class="eyebrow rv" style="margin:2.6rem 0 1.2rem">{tier.label}</p>
        <div class="logo-grid stagger">
          {tier.items.map((a) => (
            <figure class="logo-card" title={a.name}>
              <span class="logo-chip">
                {a.local
                  ? <Image src={pic(a.local)} alt={a.name} widths={[130, 260]} sizes="112px" loading="lazy" />
                  : <img src={a.logo} alt="" loading="lazy" width="130" height="34" data-logo />}
              </span>
              <figcaption>{a.name}</figcaption>
            </figure>
          ))}
        </div>
      </>
    ))}
  </div>
</section>

<!-- ═══ WORK ═══ -->
<section id="work">
  <div class="wrap">
    <div class="pin-head">
      <p class="eyebrow rv">Selected work</p>
      <h2 class="h2 rv" style="margin-top:.7rem">Systems that shipped.<br /><span class="soft">And the models behind them.</span></h2>
    </div>
    <div class="work-grid stagger">
      {projects.map((p) => (
        <button class="work" data-project={p.id} aria-haspopup="dialog">
          <div class="work-img">
            {pic(p.img) && <Image src={pic(p.img)} alt={p.title} widths={[400, 720]} sizes="(max-width:680px) 92vw, 360px" loading="lazy" />}
            <span class="work-tag">{p.tag}</span>
          </div>
          <div class="work-body">
            <h3>{p.title}</h3>
            <p>{p.blurb}</p>
            <span class="work-more">
              {p.interactive && <span class="live-chip">LIVE</span>}
              {p.interactive ? 'Try the model' : 'Details'}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PATH ═══ -->
<section id="path">
  <div class="wrap">
    <p class="eyebrow rv">Trajectory</p>
    <h2 class="h2 rv" style="margin:.7rem 0 2rem">Where the work happened.</h2>
    <div class="tl">
      {experience.map((e) => (
        <div class={`tl-item rv ${e.current ? 'now' : ''}`}>
          <h3>{e.role}</h3>
          <div class="org">{e.org}</div>
          <div class="when">{e.period} · {e.loc}</div>
          {e.stealth
            ? <span class="stealth">Stealth mode, company confidential</span>
            : <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ LAB ═══ -->
<section id="lab">
  <div class="wrap">
    <p class="eyebrow rv">Interactive</p>
    <h2 class="h2 rv" style="margin:.7rem 0 .8rem">Application fever,<br /><span class="soft">running in your browser.</span></h2>
    <p class="lede rv" style="margin-bottom:2.2rem">Applicants copy whoever scores above them. The lowest-scoring applicants catch it most. The published run reaches 21.3% in fever by year 10, up from 3%.</p>
    <div class="lab rv">
      <div class="lab-top">
        <span class="lab-title"><span class="live-chip">LIVE</span> NRMP application-fever model · prestige-biased transmission, two-stage match</span>
        <div style="display:flex;gap:.4rem">
          <button class="chip" id="sim-toggle" aria-pressed="true">Pause</button>
          <button class="chip" id="sim-reset">Reset</button>
        </div>
      </div>
      <div class="lab-body">
        <div class="lab-canvas">
          <canvas id="sim" width="560" height="330" role="img" aria-label="Animated diagram of the application-fever mechanism: a naive cohort enters, copies application behaviour upward from higher-scoring peers, reaches the two-stage match, and unmatched applicants escalate one level and return as carriers"></canvas>
          <div class="mix" aria-hidden="true">
            <div class="mix-bar" id="mix"></div>
            <div class="mix-key">
              <span><i style="background:#334155"></i>L1</span>
              <span><i style="background:#3b82f6"></i>L2</span>
              <span><i style="background:#22d3ee"></i>L3</span>
              <span><i style="background:#f59e0b"></i>L4</span>
              <span><i style="background:#f43f5e"></i>L5</span>
              <span style="margin-left:auto;color:var(--ink-3)">population mix</span>
            </div>
          </div>
        </div>
        <div class="lab-chart">
          <canvas id="chart" width="340" height="260" role="img" aria-label="Share of applicants in the fever zone over simulated years, split by academic score band"></canvas>
          <div class="chart-key">
            <span><i style="background:#f43f5e"></i>Low score</span>
            <span><i style="background:#f59e0b"></i>Medium</span>
            <span><i style="background:#22d3ee"></i>High score</span>
          </div>
        </div>
        <aside class="lab-side">
          <div class="ctrl">
            <label for="s-scale">Population <b id="v-scale">400 agents</b></label>
            <input type="range" id="s-scale" min="10" max="30" value="20" />
          </div>
          <div class="ctrl">
            <label for="s-ratio">Positions per applicant <b id="v-ratio">0.80 P/N</b></label>
            <input type="range" id="s-ratio" min="40" max="100" value="80" />
          </div>
          <div class="ctrl">
            <label for="s-influence">Reapplication rate <b id="v-influence">0.60</b></label>
            <input type="range" id="s-influence" min="0" max="100" value="60" />
          </div>
          <div class="readout">
            <div><b id="r-year">0</b><span>YEAR</span></div>
            <div><b id="r-apps">10.0</b><span>MEAN APPS</span></div>
            <div><b id="r-fever">0%</b><span>FEVER RATE</span></div>
            <div><b id="r-drift">+0%</b><span>ESCALATION</span></div>
          </div>
          <p class="lab-note">Each figure is an applicant, coloured by application level L1–L5; amber and red are the fever zone. The pool has two inputs: a naive new cohort each year, and the carriers: unmatched applicants rejoining one level higher along the dashed edge, which thickens as fever builds. Flow proportions come from the live model: a faithful port of the NetLogo source, 52 interaction cycles a year and the two-stage match.</p>
        </aside>
      </div>
    </div>
  </div>
</section>

<!-- ═══ MOMENT ═══ -->
<section class="tight">
  <div class="wrap">
    <figure class="moment rv">
      {pic('g/netlogo-wilensky.jpg') && <Image src={pic('g/netlogo-wilensky.jpg')} alt="Joshit Mohanty with Uri Wilensky, creator of NetLogo, beside the application-fever poster at the NetLogo Conference 2026" widths={[1024, 1536, 2048, 2560]} sizes="(max-width:1180px) 100vw, 1180px" quality={88} loading="lazy" />}
      <figcaption class="overlay">
        <h3>Taking the work to the room.</h3>
        <p>With Uri Wilensky, creator of NetLogo, at the first NetLogo Conference, Chicago 2026.</p>
      </figcaption>
    </figure>
  </div>
</section>

<!-- ═══ RESEARCH ═══ -->
<section id="research">
  <div class="wrap">
    <p class="eyebrow rv">Dissertation</p>
    <h2 class="h2 rv" style="margin:.7rem 0 .5rem">{research.title}</h2>
    <p class="lede rv" style="max-width:52ch">{research.subtitle}</p>
    <p class="mono rv" style="color:var(--ink-3);font-size:.75rem;margin:1.2rem 0 2.4rem">{research.status}</p>
    <div class="grid g-2 stagger" style="gap:2rem">
      <div>
        <div class="card" style="margin-bottom:1.1rem"><p style="color:var(--ink-2)">{research.premise}</p></div>
        {research.questions.map((q, i) => (
          <div class="rq"><div class="q">RESEARCH QUESTION {i + 1}</div><p>{q}</p></div>
        ))}
      </div>
      <div>
        <div class="card" style="margin-bottom:1.1rem">
          <p class="eyebrow" style="margin-bottom:.8rem">Method</p>
          <p style="color:var(--ink-2);font-size:.92rem">{research.method}</p>
        </div>
        <div class="card">
          <p class="eyebrow" style="margin-bottom:.8rem">Committee</p>
          {research.committee.map((c) => (
            <div style="display:flex;justify-content:space-between;gap:1rem;padding:.42rem 0;border-bottom:1px solid var(--line);font-size:.88rem">
              <a href={c.url} rel="noopener" target="_blank" style="color:var(--accent)">{c.name} ↗</a>
              <span class="mono" style="color:var(--ink-3);font-size:.72rem">{c.role}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ CAPABILITIES ═══ -->
<section class="tight">
  <div class="wrap">
    <p class="eyebrow rv">Capabilities</p>
    <div class="grid g-4 stagger" style="margin-top:1.6rem">
      {capabilities.map((c) => (
        <div class="card">
          <h3 style="font-size:.98rem;margin-bottom:.75rem">{c.title}</h3>
          {c.items.map((i) => <div style="font-size:.82rem;color:var(--ink-3);padding:.17rem 0">{i}</div>)}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PAPERS ═══ -->
<section id="papers">
  <div class="wrap">
    <p class="eyebrow rv">Publications</p>
    <h2 class="h2 rv" style="margin:.7rem 0 1.6rem">{publications.length} papers.<br /><span class="soft">{profile.field}.</span></h2>
    <div class="filters rv">
      <button class="chip" data-f="all" aria-pressed="true">All</button>
      {years.map((y) => <button class="chip" data-f={`y${y}`} aria-pressed="false">{y}</button>)}
      {topics.slice(0, 4).map((t) => <button class="chip" data-f={`t${t}`} aria-pressed="false">{t}</button>)}
      {topics.slice(4).map((t) => <button class="chip more-f" data-f={`t${t}`} aria-pressed="false" hidden>{t}</button>)}
      <button class="chip" id="more-filters" aria-expanded="false">+{topics.length - 4} topics</button>
      <input class="search" id="pub-q" type="search" placeholder="Search titles and venues…" aria-label="Search publications" />
    </div>
    <div id="pub-list">
      {publications.map((p, i) => (
        <article class={`pub ${i >= 8 ? 'pub-extra' : ''}`} hidden={i >= 8} data-year={p.year} data-topics={p.topics.join('|')} data-text={`${p.title} ${p.venue}`.toLowerCase()}>
          <div class="yr">{p.year}</div>
          <div>
            <h4>{p.title}</h4>
            <div class="meta">{p.authors} · {p.venue}</div>
            {p.doi && <a class="doi" href={`https://doi.org/${p.doi}`} rel="noopener" target="_blank">doi:{p.doi}</a>}
          </div>
          <div style="display:flex;gap:.35rem;flex-wrap:wrap">
            {p.citations && <span class="badge cit">{p.citations} cited</span>}
            <span class={`badge ${p.status === 'Accepted' || p.status === 'Presented' ? 'acc' : ''}`}>{p.status}</span>
          </div>
        </article>
      ))}
      <p class="empty" id="pub-empty" hidden>No papers match that filter.</p>
    </div>
    <button class="btn btn-g" id="pub-more" aria-expanded="false" style="margin-top:1.2rem">
      See all {publications.length} papers
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div style="margin-top:1.8rem;display:flex;gap:.6rem;flex-wrap:wrap">
      <a class="btn btn-g" href={profile.scholar} rel="noopener">Google Scholar ↗</a>
      <a class="btn btn-g" href={profile.orcid} rel="noopener">ORCID ↗</a>
      <a class="btn btn-g" href={profile.digitalCommons} rel="noopener">ODU Digital Commons ↗</a>
      <span class="btn btn-g" style="cursor:default">70+ citations, h-index 5</span>
    </div>
  </div>
</section>

<!-- ═══ DETAIL TABS ═══ -->
<section class="tight" id="detail">
  <div class="wrap">
    <p class="eyebrow rv" style="margin-bottom:1.2rem">The record</p>
    <div class="tabs rv" role="tablist" aria-label="Record sections">
      {['Education','Patents','Recognition','Leadership','Teaching','Reviewing','Certifications','Also'].map((t, i) => (
        <button class="tab" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'}>{t}</button>
      ))}
    </div>

    <div class="panel rows" id="panel-0" role="tabpanel" aria-labelledby="tab-0">
      {education.map((ed) => (
        <div class="row">
          <div><div class="t">{ed.degree}</div><div class="s">{ed.org} · {ed.detail}</div></div>
          <div class="w">{ed.note}</div>
        </div>
      ))}
    </div>

    <div class="panel rows" id="panel-1" role="tabpanel" aria-labelledby="tab-1" hidden>
      {patents.map((pt) => (
        <div class="row">
          <div><div class="t">{pt.title}</div><div class="s">{pt.detail}</div></div>
          <div class="w"><span class="pill-ok">{pt.status}</span> {pt.year}</div>
        </div>
      ))}
      <div class="row" style="border-bottom:none;padding-top:1.1rem">
        <div class="t" style="color:var(--ink-3);font-family:var(--mono);font-size:.7rem;letter-spacing:.08em;text-transform:uppercase">Contributed to</div>
      </div>
      {contributions.map((c) => (
        <div class="row">
          <div><div class="t">{c.title}</div><div class="s">{c.detail} {c.ref}</div></div>
          <div class="w"><span class="pill-pend">{c.status}</span> {c.year}</div>
        </div>
      ))}
    </div>

    <div class="panel rows" id="panel-2" role="tabpanel" aria-labelledby="tab-2" hidden>
      {awards.map((a) => (
        <div class="row"><div><div class="t">{a.title}</div><div class="s">{a.org}</div></div><div class="w">{a.year}</div></div>
      ))}
      {fellowships.map((f) => (
        <div class="row"><div><div class="t">{f.title}</div><div class="s">{f.org}</div></div><div class="w">{f.year}</div></div>
      ))}
      <div class="row">
        <div><div class="t">{record.title}</div><div class="s">{record.detail}</div></div>
        <div class="w">{record.year}</div>
      </div>
    </div>

    <div class="panel rows" id="panel-3" role="tabpanel" aria-labelledby="tab-3" hidden>
      {leadership.map((l) => (
        <div class="row"><div><div class="t">{l.role}</div><div class="s">{l.org}</div></div><div class="w">{l.period}</div></div>
      ))}
    </div>

    <div class="panel rows" id="panel-4" role="tabpanel" aria-labelledby="tab-4" hidden>
      {teaching.map((t) => (
        <div class="row"><div><div class="t">{t.role}, {t.org}</div><div class="s">{t.detail}</div></div><div class="w">{t.period}</div></div>
      ))}
    </div>

    <div class="panel rows" id="panel-5" role="tabpanel" aria-labelledby="tab-5" hidden>
      {reviewer.conferences.map((c) => (
        <div class="row"><div><div class="t">{c}</div></div><div class="w">Reviewer</div></div>
      ))}
      {reviewer.professional.map((c) => (
        <div class="row"><div><div class="t">{c}</div></div><div class="w">Judge</div></div>
      ))}
    </div>

    <div class="panel rows" id="panel-6" role="tabpanel" aria-labelledby="tab-6" hidden>
      {certifications.map((c) => (
        <div class="row"><div><div class="t">{c.name}</div><div class="s">{c.org}</div></div><div class="w">{c.year}</div></div>
      ))}
    </div>

    <div class="panel rows" id="panel-7" role="tabpanel" aria-labelledby="tab-7" hidden>
      {additional.map((x) => (
        <div class="row"><div><div class="t">{x.role}</div><div class="s">{x.org}</div></div><div class="w">{x.period}</div></div>
      ))}
      {talks.map((t) => (
        <div class="row"><div><div class="t"><a href={t.url} rel="noopener">{t.title} ↗</a></div><div class="s">Invited talk</div></div><div class="w">{t.year}</div></div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ GRANTS ═══ -->
<section class="tight">
  <div class="wrap">
    <p class="eyebrow rv" style="margin-bottom:1.2rem">Awarded research grants</p>
    <div class="grid g-2 stagger">
      {grants.map((gr) => (
        <div class="card">
          <h3 style="font-size:1rem;margin-bottom:.2rem">{gr.url ? <a href={gr.url} rel="noopener" target="_blank">{gr.title} ↗</a> : gr.title}</h3>
          <div class="mono" style="color:var(--accent);font-size:1.3rem;margin:.5rem 0 .8rem">{gr.amount}</div>
          <div class="rows">
            <div class="row"><div class="t">Role</div><div class="w">{gr.role}</div></div>
            <div class="row"><div class="t">Supervisor / PI</div><div class="w">{gr.pi}</div></div>
            <div class="row"><div class="t">Agency</div><div class="w">{gr.agency}</div></div>
            <div class="row"><div class="t">Period</div><div class="w">{gr.period}</div></div>
            <div class="row"><div class="t">Contract</div><div class="w">{gr.contract}</div></div>
            <div class="row"><div class="t">Project no.</div><div class="w">{gr.project}</div></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PRESS ═══ -->
<section class="tight" id="press">
  <div class="wrap">
    <p class="eyebrow rv" style="margin-bottom:1.2rem">Media coverage</p>
    <div class="press-grid stagger">
      {press.map((m) => (
        <a class="press-item" href={m.url} rel="noopener" target="_blank">
          <span class="chip-logo"><img src={m.logo} alt={m.outlet} loading="lazy" width="110" height="26" /></span>
          <span class="n">{m.outlet}</span>
          <span class="y">{m.year} ↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ GALLERY ═══ -->
<section id="gallery">
  <div class="wrap">
    <p class="eyebrow rv">In the field</p>
    <h2 class="h2 rv" style="margin:.7rem 0 1.8rem">Conferences, labs, launches.</h2>
  </div>
  <div class="rail" id="gal" role="region" aria-label="Photo gallery">
    <div class="rail-track" id="gal-track">
      {gallery.map((g, i) => (
        <button class="shot" data-i={i} aria-label={`View: ${g.caption}`}>
          {pic(g.img) && <Image src={pic(g.img)} alt={g.caption} widths={[420, 840]} sizes="(max-width:680px) 78vw, 340px" loading="lazy" />}
          <span class="cap">{g.caption}</span>
        </button>
      ))}
      {gallery.map((g, i) => (
        <button class="shot" data-i={i} tabindex="-1" aria-hidden="true">
          {pic(g.img) && <Image src={pic(g.img)} alt="" widths={[420, 840]} sizes="(max-width:680px) 78vw, 340px" loading="lazy" />}
          <span class="cap">{g.caption}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- ═══ CONTACT ═══ -->
<section class="contact" id="contact">
  <div class="wrap">
    <p class="eyebrow rv" style="justify-content:center">Contact</p>
    <h2 class="rv" style="margin-top:.8rem">Let's build a model<br />of the thing you can't measure.</h2>
    <p class="lede rv" style="margin:0 auto 2rem;text-align:center">{profile.disciplines}</p>
    <div class="cta-row rv" style="justify-content:center">
      <a class="btn btn-p" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn btn-g" href={profile.linkedin} rel="noopener">LinkedIn</a>
      <a class="btn btn-g" href={profile.resume}>Résumé</a>
      <a class="btn btn-g" href={profile.orcid} rel="noopener">ORCID</a>
    </div>
  </div>
</section>

</div><!-- /after-hero -->

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-bd" data-close></div>
  <div class="modal-box">
    <button class="x-btn" data-close aria-label="Close">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <div class="modal-hero" id="modal-img"></div>
    <div class="modal-in">
      <div class="m-tag" id="modal-tag"></div>
      <h3 id="modal-title"></h3>
      <p id="modal-detail"></p>
      <div class="modal-stats" id="modal-stats"></div>
    </div>
  </div>
</div>

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lb-nav prev" id="lb-prev" aria-label="Previous">‹</button>
  <img id="lb-img" src="" alt="" />
  <span class="cap" id="lb-cap"></span>
  <button class="lb-nav next" id="lb-next" aria-label="Next">›</button>
</div>

<script define:vars={{ projectData: projects, galleryData: gallery.map((g, i) => ({ ...g, i })) }}>
  window.__PROJECTS__ = projectData;
  window.__GALLERY__ = galleryData;
</script>
<script>import '../scripts/app.js';</script>
</Base>
